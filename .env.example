# Copy to `.env` and fill values. Never commit `.env`.
# Preferred: Tiingo FX (OpenBB currency.price.historical)
TIINGO_TOKEN=
# Alternate accepted by adapter:
# TIINGO_API_KEY=

# Fallback spot candidate via OpenBB
FMP_API_KEY=

# Optional macro (not used by strategy yet)
# FRED_API_KEY=

# Databento historical futures (Phase 23+ COMEX GC)
DATABENTO_API_KEY=

# Tradovate REST — FundedNext account telemetry only (Phase 54D). Never commit `.env`.
# Live: https://live.tradovateapi.com/v1  Demo: https://demo.tradovateapi.com/v1
TRADOVATE_ENV=live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=
TRADOVATE_APP_VERSION=1.0.0
TRADOVATE_CID=
TRADOVATE_SEC=
# Optional stable device UUID. If empty, a local id is stored in state/tradovate_device_id.txt
TRADOVATE_DEVICE_ID=

# Phase 54E FundedNext MCP — read-only account/risk telemetry. Never commit real tokens.
# Independent of Cursor chat. Prefer gitignored state/fundednext_mcp_oauth.json for refresh.
FUNDEDNEXT_MCP_ACCESS_TOKEN=
FUNDEDNEXT_MCP_REFRESH_TOKEN=
FUNDEDNEXT_MCP_CLIENT_ID=
FUNDEDNEXT_MCP_CLIENT_SECRET=

# Phase 55+ outbound notifications (Apprise). Never commit the real URL.
# Telegram example (do not commit): tgram://BOT_TOKEN/CHAT_ID
# Outbound only — no Telegram commands, no execution control.
AITRADE_APPRISE_URL=
AITRADE_NOTIFICATIONS_ENABLED=false
# Optional: AITRADE_NOTIFY_SHADOW=false
# Optional: AITRADE_NOTIFY_REMINDER_SEC=21600

# Phase 55C FundedNext one-shot canary. Missing/unset/false = DISARMED on every start.
# Do NOT set true except as the Monday operator arm after READY_FOR_PROP_CANARY.
# Does not enable general PROP_EXECUTION. Restart/reconnect do not preserve ARMED.
# AITRADE_PROP_CANARY_EXECUTION=false

# Phase 55D unattended FundedNext one-shot canary. Missing/unset/false = DISABLED.
# Requires explicit operator enable for the trading day AFTER this flag is true.
# Does not enable general PROP_EXECUTION. Restart does not auto-resume WAITING_DVP.
# AITRADE_UNATTENDED_PROP_CANARY=false
